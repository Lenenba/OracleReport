APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
#
# Skip auth middleware locally to access dashboard directly.
# BYPASS_LOGIN=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Optional: separate connection alias used by DB_CONNECTION=oraclecloudReport
# ORACLECLOUDREPORT_DB_DRIVER=mysql
# ORACLECLOUDREPORT_DB_HOST=127.0.0.1
# ORACLECLOUDREPORT_DB_PORT=3306
# ORACLECLOUDREPORT_DB_DATABASE=laravel
# ORACLECLOUDREPORT_DB_USERNAME=root
# ORACLECLOUDREPORT_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BIP_DEV2_LABEL=DEV2
BIP_DEV2_BASE_URL=
BIP_DEV2_USERNAME=
BIP_DEV2_PASSWORD=

BIP_TEST_LABEL=TEST
BIP_TEST_BASE_URL=
BIP_TEST_USERNAME=
BIP_TEST_PASSWORD=

BIP_HTTP_TIMEOUT=120
BIP_HTTP_CONNECT_TIMEOUT=10
BIP_HTTP_VERIFY=true

# SQL Runner (read-only)
SQL_DEV2_LABEL=DEV2
SQL_DEV2_CONNECTION=oraclecloudReport
SQL_DEV2_REPORT_PATH=
SQL_TEST_LABEL=TEST
SQL_TEST_CONNECTION=oraclecloudReport
SQL_TEST_REPORT_PATH=
SQL_RUNNER_MODE=bip
SQL_RUNNER_REPORT_FORMAT=csv
SQL_RUNNER_PARAM_SQL=P_SQL
SQL_RUNNER_PARAM_LIMIT=P_LIMIT
SQL_RUNNER_CSV_DELIMITER=,
SQL_RUNNER_CSV_ENCLOSURE="
SQL_RUNNER_CSV_ESCAPE=\\
SQL_RUNNER_DEFAULT_ROWS=200
SQL_RUNNER_MAX_ROWS=1000
SQL_RUNNER_MAX_QUERY_LENGTH=6000

# Config report compare (Fusion Configuration Report export)
CONFIG_REPORT_DEV2_LABEL=DEV2
# CONFIG_REPORT_DEV2_PATH=public/Config/ConfigurationReport DEV2.xlsx
CONFIG_REPORT_TEST_LABEL=TEST
# CONFIG_REPORT_TEST_PATH=public/Config/ConfigurationReport TEST.xlsx
CONFIG_REPORT_SHEET_SUFFIX=_c
CONFIG_REPORT_ROW_SCAN_LIMIT=80
CONFIG_REPORT_FIELD_SCAN_LIMIT=0
CONFIG_REPORT_FIELD_CHUNK_SIZE=500
CONFIG_REPORT_SQL_MAX_LENGTH=12000

VITE_APP_NAME="${APP_NAME}"
